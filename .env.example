# ==== Channel: WhatsApp ====
# Daftar nomor WA yang boleh mengirim transaksi, dipisah koma (format 62xxxxxxxxxx atau 08xxxxxxxxxx).
# Kosongkan = terima dari semua nomor (tidak disarankan).
WA_ALLOWED_NUMBERS=6285178249700,628xxxxxxxxx
# Mapping nomor pasangan Suami & Istri (opsional, juga bisa diatur langsung via chat /pasangan):
WA_COUPLE_ROLES=6285178249700:Suami,628xxxxxxxxx:Istri
# Izinkan bot menerima pesan dari grup WA (mis. grup khusus keuangan Suami & Istri)
WA_ALLOW_GROUPS=false
# Kalau true (default), kolom Note otomatis ditandai "via <Suami/Istri/nama pengirim>"
WA_TAG_SENDER_IN_NOTE=true
# Override manual versi WA Web (opsional). Isi HANYA kalau bot gagal konek dengan
# error 405 "Connection Failure" terus-menerus meski sudah update dependency.
# Format: mayor,minor,build — cek angka terbaru di README bagian Troubleshooting.
# WA_BAILEYS_VERSION=2,3000,1037641644

# ==== Jatah Dana / Budget Default (opsional, bisa diatur kapan saja via chat /dana atau /jatah) ====
DEFAULT_MONTHLY_BUDGET=0
DEFAULT_WEEKLY_BUDGET=0

# ==== Laporan Otomatis Terjadwal / Scheduled Report (opsional, juga bisa diatur via chat /jadwal) ====
AUTO_REPORT_ENABLED=true
AUTO_REPORT_HOUR=8
# Nomor WA / JID penerima laporan otomatis Senin pagi & tanggal 1 pagi (kosongkan = kirim ke WA_ALLOWED_NUMBERS)
WA_REPORT_RECIPIENTS=

# ==== Google Sheets ====
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Private key dari file JSON service account. Ganti newline literal \n tetap sebagai \n (lihat README).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
# TTL cache in-memory untuk pembacaan transaksi (ms, default 10000 = 10 detik)
TRANSACTIONS_CACHE_TTL_MS=10000

# ==== AI Parser Fallback (opsional, hanya dipakai kalau regex parser gagal) ====
ANTHROPIC_API_KEY=sk-ant-xxxx
AI_PARSER_ENABLED=true
AI_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT_MS=10000

# ==== General ====
LOG_LEVEL=info
TIMEZONE=Asia/Jakarta
